# Copy to e.g. /etc/esbn-hdf-download/esbn.env, chmod 600, and fill in.

# ESB Networks online account (myaccount.esbnetworks.ie)
ESBN_USERNAME=you@example.com
ESBN_PASSWORD=change-me
# 11-digit MPRN, as shown on your bill
ESBN_MPRN=10000000000

# Where to save the CSV (written atomically; the previous file is kept if a run fails)
OUTPUT_PATH=/var/lib/esbn-hdf-download/esbn_hdf_latest.csv

# Optional: keep the portal session between runs (fewer logins, fewer CAPTCHAs)
ESBN_COOKIE_FILE=/var/lib/esbn-hdf-download/cookies.txt

# Optional: 2Captcha, for when ESB shows a reCAPTCHA at sign-in
TWOCAPTCHA_API_KEY=
# Warn (but still save the CSV) when the 2Captcha balance falls below this, in USD
TWOCAPTCHA_MIN_BALANCE=2.00
TWOCAPTCHA_TIMEOUT_SECONDS=180

# Fail if the newest reading is older than this (ESB normally publishes 1-4 days behind)
MAX_DATA_AGE_DAYS=7

# Optional: JSON POST on failure or warning:
#   {"level": "error"|"warning", "source": "esbn-hdf-download", "reason": "..."}
ALERT_WEBHOOK_URL=
